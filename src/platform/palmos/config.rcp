FORM ID 1300 AT (0 0 160 160) USABLE
BEGIN
 TITLE "NIO Config - Info"
 PUSHBUTTON "Hosts" ID 9001 AT (2 16 50 12) USABLE GROUP 9
 PUSHBUTTON "Info" ID 9002 AT (54 16 50 12) USABLE GROUP 9
 PUSHBUTTON "Setup" ID 9003 AT (106 16 52 12) USABLE GROUP 9
 BUTTON "Refresh" ID 1301 AT (2 145 45 13) USABLE FRAME
END

FORM ID 1400 AT (0 0 160 160) USABLE
BEGIN
 TITLE "Edit host or URI"
 LABEL "Host, host:port or full URI:" AUTOID AT (2 20)
 FIELD ID 1401 AT (2 36 156 44) EDITABLE UNDERLINED MAXCHARS 240 USABLE
 LABEL "Examples: apps.irata.online" AUTOID AT (2 89)
 LABEL "tnfs://host/PALM/ or sd0:/" AUTOID AT (2 102)
 LABEL "Blank removes this host." AUTOID AT (2 116)
 BUTTON "Save" ID 1402 AT (2 145 36 13) USABLE FRAME
 BUTTON "Cancel" ID 1403 AT (44 145 40 13) USABLE FRAME
 GRAFFITISTATEINDICATOR AT (145 145)
END

FORM ID 1500 AT (0 0 160 160) USABLE
BEGIN
 TITLE "NIO Config - Wi-Fi"
 PUSHBUTTON "Hosts" ID 9001 AT (2 16 50 12) USABLE GROUP 9
 PUSHBUTTON "Info" ID 9002 AT (54 16 50 12) USABLE GROUP 9
 PUSHBUTTON "Setup" ID 9003 AT (106 16 52 12) USABLE GROUP 9
 LABEL "SSID:" AUTOID AT (2 49)
 FIELD ID 1501 AT (34 48 124 12) EDITABLE UNDERLINED SINGLELINE MAXCHARS 32 USABLE
 LABEL "Password (shown; blank = open):" AUTOID AT (2 64)
 FIELD ID 1502 AT (2 78 156 12) EDITABLE UNDERLINED SINGLELINE MAXCHARS 64 USABLE
 LIST "" ID 1503 AT (2 95 156 44) VISIBLEITEMS 4 USABLE
 BUTTON "Scan" ID 1504 AT (2 145 42 13) USABLE FRAME
 BUTTON "Join" ID 1505 AT (50 145 42 13) USABLE FRAME
 BUTTON "Done" ID 1506 AT (98 145 40 13) USABLE FRAME
 GRAFFITISTATEINDICATOR AT (145 145)
END

FORM ID 1600 AT (8 28 144 104) USABLE MODAL SAVEBEHIND
BEGIN
 TITLE "Installing"
END

ALERT ID 9100 INFORMATION
BEGIN
 TITLE "NIO Config"
 MESSAGE "^1^2^3"
 BUTTONS "OK"
END
ALERT ID 9101 CONFIRMATION
BEGIN
 TITLE "Install"
 MESSAGE "Install ^1 on this Palm?^2^3"
 BUTTONS "Install" "Cancel"
END
ALERT ID 9102 CONFIRMATION
BEGIN
 TITLE "Replace"
 MESSAGE "^1 is already installed. Replace it?^2^3"
 BUTTONS "Replace" "Cancel"
END
ALERT ID 9103 CONFIRMATION
BEGIN
 TITLE "Reset NIO link"
 MESSAGE "^1 Clear the recovery marker only after doing this. It cannot undo an earlier command. The Palm is not reset.^2^3"
 BUTTONS "Cancel" "Reset link"
END
